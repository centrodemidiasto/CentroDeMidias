rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regra padrão: nega todo o acesso
    match /{document=**} {
      allow read, write: if false;
    }

    // Permite leitura pública para agendamentos e bloqueios, 
    // mas restringe a escrita a usuários autenticados (admin).
    match /reservas/{reservaId} {
      allow read: if true;
      allow create: if true; // Qualquer um pode solicitar
      allow update, delete: if request.auth != null; // Apenas admin pode alterar/deletar
    }

    match /horariosBloqueados/{bloqueioId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Apenas usuários autenticados (admin) podem gerenciar outros usuários
    // e acessar os relatórios consolidados.
    match /usuarios/{userId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /relatorios_consolidados/{relatorioId} {
        allow read, create, update, delete: if request.auth != null;
    }
  }
}
