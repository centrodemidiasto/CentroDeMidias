rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a coleção de Agendamentos (bookings)
    match /bookings/{bookingId} {
      // Qualquer pessoa pode criar um novo agendamento (página pública)
      // Qualquer pessoa pode ler para verificar a disponibilidade na agenda
      allow read, create: if true;

      // Apenas usuários autenticados (admin) podem atualizar (aprovar/rejeitar) ou deletar
      allow update, delete: if request.auth != null;
    }

    // Regras para a coleção de Horários Bloqueados manualmente
    match /blockedSlots/{slotId} {
      // Qualquer pessoa pode ler os horários bloqueados para a agenda pública
      allow read: if true;
      
      // Apenas usuários autenticados (admin) podem criar, atualizar ou deletar bloqueios
      allow write: if request.auth != null;
    }
  }
}
